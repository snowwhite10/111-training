@model LowStockViewModel
@{
    ViewData["Title"] = "低庫存警示";
}

<h1 class="h3 mb-3">低庫存警示</h1>

<form method="get" asp-action="LowStock" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label asp-for="Threshold" class="form-label"></label>
        <input asp-for="Threshold" class="form-control" />
        <span asp-validation-for="Threshold" class="text-danger"></span>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">查詢</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>SKU</th>
            <th>名稱</th>
            <th class="text-end">現有庫存</th>
            <th class="text-end">近 30 天售出數量</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Products)
        {
            <tr class="@(p.IsCriticallyLow ? "table-danger" : "")">
                <td>@p.Sku</td>
                <td>@p.Name</td>
                <td class="text-end">@p.StockQuantity</td>
                <td class="text-end">@p.SoldQuantityLast30Days</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
